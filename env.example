# LINE Bot Configuration
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token
LINE_CHANNEL_SECRET=your_channel_secret
IMG_BOT_CHANNEL_ACCESS_TOKEN=your_img_bot_channel_access_token
IMG_BOT_CHANNEL_SECRET=your_img_bot_channel_secret_here
IMAGE_STORAGE_PATH=/app/storage/images
OCR_STORAGE_PATH=/app/storage/ocr-results

# AI Service Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional overrides (free-tier models). Text defaults to gemini-3.5-flash-lite, image OCR to gemini-2.5-flash
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-2.5-flash

# WordBridge API Configuration
WORDBRIDGE_API_URL=https://pidashinnas.myds.me/projects/wordbridge/api/graphql

# NAS Deployment Configuration
NAS_HOST=your-nas-ip-or-hostname
NAS_USER=your-nas-username
NAS_PATH=/path/to/your/bot/directory

# Server Configuration
PORT=4001
NODE_ENV=development

